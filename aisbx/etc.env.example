# ── aienv shared configuration - COMMITTABLE defaults ─────────────────────────
# Secrets (GitHub PAT) go in .env at this level (copy .env.example, chmod 600,
# never commit). Per-project overrides live in <project>/.env (private) and
# <project>/etc.env (committable). Precedence (Msg 9 convention):
#   <project>/.env  >  <project>/etc.env  >  <toolkit>/.env  >  this file

# Default workspace to mount when 'new' gets no path (empty = path required)
WORKSPACE=

# Sandbox sizing (sbx create --cpus / -m; 512m minimum, 0 CPUs = all host CPUs)
CPUS=2
MEMORY=4g

# Network preset applied by 'aienv.sh policy init' (allow-all|balanced|deny-all)
POLICY_PRESET=balanced

# Ollama AI server as seen from INSIDE the sandbox.
# Same host: keep host.docker.internal - the sandbox proxy translates it to
# 'localhost' on the host, so Ollama can keep listening on 127.0.0.1 only.
# 'aienv.sh policy stack <name>' derives the localhost:<port> allow rule from
# this URL. Another machine: use its NetBird MagicDNS name or 100.x mesh IP
# (rule derived the same way, host:port). Port in the URL is required.
AI_SERVER_URL=http://host.docker.internal:11434

# Models exposed to pi (first entry is the default). Pull them on the AI
# server with: ollama pull <model>
AI_MODELS=qwen2.5-coder:3b qwen2.5-coder:7b

# Extra destinations the stack may reach, space separated, beyond the preset
# baseline and the stack's own needs (localhost:11434, pi.dev, herdr.dev,
# deb.nodesource.com are always added by 'aienv.sh policy stack <name>').
EXTRA_ALLOW=

# Dev-server ports published from the sandbox at creation (OS picks the free
# host port; mappings may change at restart - check with: aienv.sh ls <name>)
PREVIEW_PORTS=3000 5173 8080

# Optional container image for the sandbox (empty = official 'shell' base
# image). Example: docker.io/library/node:lts-trixie - sbx does NOT add the
# docker.io prefix by itself (see Docker docs: sbx run --template).
SBX_TEMPLATE=

# Timezone inside sandboxes
TZ=Europe/Rome

# Where project folders are created (empty = <toolkit>/projects)
PROJECTS_DIR=
