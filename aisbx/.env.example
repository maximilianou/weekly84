# ── sbx private configuration - copy to .env (NEVER commit) ────────────────────
#   cp .env.example .env && chmod 600 .env
# These are FALLBACKS for all projects; per-project values in <project>/.env win.

# Your SSH public key, injected into every sandbox: enables ssh + the Herdr app
# connection (machines over SSH). Generate one with: ssh-keygen -t ed25519
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... you@yourmachine

# Optional fallback GitHub PAT (fine-grained; prefer per-project tokens)
GITHUB_TOKEN=

# NOTE: no NetBird secrets here - the HOST is your only mesh peer and sandboxes
# publish their ports on it (docs/NETBIRD.md). No VPN anything per project.
