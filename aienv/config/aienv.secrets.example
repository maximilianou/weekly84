# ── aienv secrets - PRIVATE: copy to config/aienv.secrets (gitignored) ────────
#   cp config/aienv.secrets.example config/aienv.secrets && chmod 600 config/aienv.secrets
# These are FALLBACKS for all projects; per-project values in <project>/.env win.

# Your SSH public key, injected into every environment: enables ssh + herdr
# remote machines + NetBird access. Generate one with: ssh-keygen -t ed25519
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... you@yourmachine

# Optional fallback GitHub PAT (fine-grained; prefer per-project tokens)
GITHUB_TOKEN=

# Optional fallback NetBird setup key (prefer per-project keys with auto-groups)
NETBIRD_SETUP_KEY=
