name: aienv-__NAME__
# Isolated development environment for __NAME__ - generated by 'aienv create/render'.
# After editing aienv.config or .env run: aienv render __NAME__ (then recreate the container).

services:
  dev:
    container_name: aienv-__NAME__
    hostname: __NAME__
    image: aienv-base:latest
    working_dir: /workspace
    init: true
    tty: true
    stdin_open: true
    restart: unless-stopped
    entrypoint: ["/usr/local/bin/aienv-entrypoint"]
    command: ["sleep", "infinity"]
    env_file:
      - .env
    environment:
      TZ: __TZ__
      AI_SERVER_URL: ${AI_SERVER_URL:-}
      OLLAMA_HOST: ${AI_SERVER_URL:-}
      SSH_PUBLIC_KEY: ${SSH_PUBLIC_KEY:-}
    volumes:
      - ./workspace:/workspace
      - ./gitconfig:/home/dev/.gitconfig:ro
      - ./pi-models.json:/home/dev/.pi/models.json:ro
      - ./pi-models.json:/home/dev/.pi/agent/models.json:ro
      - ./netbird-state:/var/lib/netbird
__PORTS__
    # NetBird client needs network privileges; they apply ONLY to this
    # environment's own network namespace (pattern from NetBird's official
    # Docker client image).
    cap_add: [NET_ADMIN, SYS_ADMIN, SYS_RESOURCE]
    devices: ["/dev/net/tun:/dev/net/tun"]
    pids_limit: __PIDS_LIMIT__
    mem_limit: __MEM_LIMIT__
    cpus: __CPU_LIMIT__

networks:
  default:
    name: aienv-__NAME__-net
