# =============================================================================
# docker-sbx-gitops — etc.env.example
#
# Single source of truth for EVERY variable of the development environment.
# Copy to etc.env and adjust:   cp etc.env.example etc.env
# etc.env is sourced by ./setup.sh and ./sbx.sh, and its values are synced
# into the sandbox (via /etc/sandbox-persistent.sh) by `./sbx.sh up`.
#
# Keep this file committed (no secrets) and keep etc.env out of git.
# =============================================================================

# ── Sandbox identity ─────────────────────────────────────────────────────────
# Name of the sandbox as shown by `sbx ls`. Must stay in sync with `name:`
# in env/sbxenv.yaml.
SBX_NAME=devstack

# Path to the declarative environment file (relative to the repo root).
# Docs: https://docs.docker.com/ai/sandboxes/configuration/environment-files/
SBX_ENV_FILE=env/sbxenv.yaml

# ── Local AI on the host (Ollama) ────────────────────────────────────────────
# Which local endpoint pi should use inside the sandbox:
#   ollama       → host Ollama (AI_OLLAMA_URL)
#   model-runner → Docker Model Runner (AI_MODEL_RUNNER_URL)
AI_PROVIDER=ollama

# URL by which the SANDBOX reaches the host Ollama daemon.
# `host.docker.internal` is the standard alias for the host from containers.
# The sandbox outbound policy allows this host (see kit/devstack/devstack.yaml
# and policy/README.md).
AI_OLLAMA_URL=http://host.docker.internal:11434

# Model pulled/used by Ollama and written into pi's models.json.
AI_OLLAMA_MODEL=qwen2.5-coder:7b

# OpenAI-compatible endpoint of the Docker Model Runner (fallback provider).
AI_MODEL_RUNNER_URL=http://model-runner.docker.internal/engines/v1

# Bind address Ollama must listen on so that containers can reach it
# (127.0.0.1 is NOT reachable from the sandbox — use 0.0.0.0).
# ./setup.sh checks this and prints the fix if needed.
OLLAMA_BIND_HOST=0.0.0.0

# ── PostgreSQL (development, container inside the sandbox) ───────────────────
# Image tag. postgres:16-alpine is the pinned development version.
POSTGRES_IMAGE=postgres:16-alpine

# Dev credentials (NOT production secrets — still, keep etc.env out of git).
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev-password-change-me
POSTGRES_DB=appdb

# DNS name of the Postgres container on the sandbox-internal docker network.
# Used by Adminer and reachable from any container attached to SBX_NET_NAME.
POSTGRES_HOST=pg-dev

# Named volume so dev data survives sandbox restarts/re-creates.
PGDATA_VOLUME=devstack-pgdata

# Port Postgres listens on inside the sandbox (published to the host by
# env/sbxenv.yaml `ports:`; keep the two files in sync).
PG_PORT=5432

# ── PostgreSQL admin (Adminer, container inside the sandbox) ─────────────────
ADMINER_IMAGE=adminer:4
ADMINER_PORT=8081
# Adminer's default "server" field in the login screen → Postgres container.
ADMINER_DEFAULT_SERVER=pg-dev

# ── TypeScript API (development, node process inside the sandbox) ────────────
API_PORT=4000
NODE_ENV=development

# Optional override of the API's connection string. When empty, the bootstrap
# composes it from the POSTGRES_* / PG_PORT variables:
#   postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@127.0.0.1:$PG_PORT/$POSTGRES_DB
#DATABASE_URL=

# ── TypeScript React frontend (development, Vite inside the sandbox) ─────────
WEB_PORT=5173
# Base path the frontend uses to call the API (Vite proxies it → API_PORT).
VITE_API_BASE=/api

# ── Sandbox-internal networking ──────────────────────────────────────────────
# Docker network inside the sandbox that carries pg-dev ↔ adminer-dev ↔ any
# container the agent starts. Host-side processes (API/web) use the loopback
# publishing of PG_PORT/API_PORT/WEB_PORT instead.
SBX_NET_NAME=devnet
